---
import "./CVHeader.css";

interface Props {
  name: string;
  subtitle: string;
}

const { name, subtitle } = Astro.props;
---

<header class="cv-header">
  <h1 class="cv-header-name">{name}</h1>
  <p class="cv-header-subtitle">{subtitle}</p>
  <div class="cv-header-rule" aria-hidden="true"></div>
</header>
