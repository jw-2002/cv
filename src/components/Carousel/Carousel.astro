---
interface Slide {
  title: string;
  body: string;
}

interface Props {
  slides: Slide[];
}

const { slides = [] } = Astro.props;
---

<div class="carousel card stack" data-carousel>
  <div class="window-bar">
    <span class="window-title">slide_viewer.exe</span>
    <span class="window-status">
      {slides.length} {slides.length === 1 ? "item" : "items"}
    </span>
  </div>

  <div class="slides">
    {
      slides.length === 0 ? (
        <article class="slide active" data-index="0">
          <h3>No slides loaded</h3>
          <p>Add slide content to this component to populate the viewer.</p>
        </article>
      ) : (
        slides.map((slide, idx) => (
          <article class={idx === 0 ? "slide active" : "slide"} data-index={idx}>
            <h3>{slide.title}</h3>
            <p>{slide.body}</p>
          </article>
        ))
      )
    }
  </div>

  <div class="carousel-nav">
    <button class="nav-btn" type="button" data-dir="prev" aria-label="Previous slide" disabled={slides.length < 2}>
      Prev
    </button>
    <div class="dots" aria-label="Slide pagination">
      {
        slides.map((_, idx) => (
          <button
            type="button"
            class={idx === 0 ? "dot active" : "dot"}
            data-index={idx}
            aria-label={`Show slide ${idx + 1}`}
          />
        ))
      }
    </div>
    <button class="nav-btn" type="button" data-dir="next" aria-label="Next slide" disabled={slides.length < 2}>
      Next
    </button>
  </div>
</div>

<script>
  const carousels = Array.from(document.querySelectorAll("[data-carousel]"));

  carousels.forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll(".slide"));
    const dots = Array.from(carousel.querySelectorAll(".dot"));
    const buttons = Array.from(carousel.querySelectorAll(".nav-btn"));

    if (slides.length < 2) {
      return;
    }

    let current = 0;

    const setActive = (index) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle("active", i === current));
      dots.forEach((dot, i) => dot.classList.toggle("active", i === current));
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const dir = btn.dataset.dir === "next" ? 1 : -1;
        setActive(current + dir);
      });
    });

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        setActive(index);
      });
    });
  });
</script>

<style>
  .carousel.card {
    position: relative;
    overflow: hidden;
    padding: 0;
    border: 2px solid var(--color-border);
    gap: 0;
  }

  .window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 0.45rem 0.7rem;
    border-bottom: 2px solid var(--color-border);
    background: var(--color-green);
    color: var(--color-white);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .window-title,
  .window-status {
    line-height: 1;
  }

  .slides {
    padding: var(--space-md);
    min-height: 200px;
    background: var(--color-surface);
  }

  .slide {
    display: none;
  }

  .slide.active {
    display: grid;
    gap: var(--space-xs);
  }

  .slide p {
    color: var(--color-text);
  }

  .carousel-nav {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-sm);
    padding: 0 var(--space-md) var(--space-md);
  }

  .nav-btn {
    min-width: 5.3rem;
  }

  .dots {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .dot {
    width: 16px;
    height: 16px;
    min-width: 0;
    padding: 0;
    border: 2px solid var(--color-border);
    background: var(--color-surface);
    border-radius: 0;
    box-shadow: none;
    font-size: 0;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    cursor: pointer;
    transition:
      background 150ms ease,
      transform 150ms ease,
      box-shadow 150ms ease;
  }

  .dot.active {
    background: var(--color-green);
    box-shadow: 1px 1px 0 0 var(--color-border);
  }

  .dot:hover {
    background: var(--color-purple);
  }

  .dot:active {
    transform: none;
  }

  @media (max-width: 640px) {
    .carousel-nav {
      grid-template-columns: 1fr;
    }

    .nav-btn {
      width: 100%;
    }
  }
</style>
