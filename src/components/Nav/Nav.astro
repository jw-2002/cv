---
import config from "./config";
import "./nav.css";

const rawBase = import.meta.env.BASE_URL || "/";
const base = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;
const resolveHref = (url: string) => (url === "/" ? "/" : `${base}${url}`);

const normalizePath = (path: string) => {
  const clean = path.replace(/\/+$/, "");
  return clean || "/";
};

const stripBase = (path: string) => {
  if (base && base !== "/" && path.startsWith(base)) {
    const stripped = path.slice(base.length);
    return stripped.startsWith("/") ? stripped : `/${stripped}`;
  }

  return path;
};

const currentPath = normalizePath(stripBase(Astro.url.pathname));
---

<nav>
  <h2>jw-2002</h2>
  <ul>
    {
      config.map((item) => {
        const isActive = normalizePath(item.url) === currentPath;

        return (
          <li>
            <a href={resolveHref(item.url)} aria-current={isActive ? "page" : undefined}>
              {item.title}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
