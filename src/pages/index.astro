---
import DefaultTemplate from "../components/DefaultTemplate/DefaultTemplate.astro";
import CVHeader from "../components/CVHeader/CVHeader.astro";
import CVSection from "../components/CVSection/CVSection.astro";

const skills = [
  {
    group: "Backend",
    items: [
      "C#",
      ".NET 8",
      "ASP.NET Core",
      "REST APIs",
      "GraphQL – HotChocolate",
      "EF Core",
      "Dapper",
      "LINQ",
      "Python",
      "SQL – PostgreSQL",
      "Dependency Injection",
      "JWT",
    ],
  },
  {
    group: "Frontend",
    items: ["React", "TypeScript", "JavaScript", "React Router", "React Hooks", "CSS", "Axios", "Storybook", "Jest"],
  },
  {
    group: "Other",
    items: ["Azure", "Terraform", "Docker", "Git", "CAP", "Airflow"],
  },
];
---

<DefaultTemplate
  title="Jack Williamson — Full-stack Web Developer"
  metaDescription="CV of Jack Williamson, Full-stack Web Developer specialising in React, TypeScript and .NET."
>
  <div class="cv-header-wrap">
    <CVHeader name="JACK WILLIAMSON" subtitle="Full-stack Web Developer — React & .NET" />
  </div>

  <CVSection title="Profile" open={true}>
    <p class="cv-profile">
      Full-stack Web Developer with 3+ years' commercial experience delivering and maintaining modern web applications
      using <b>React, TypeScript, C#, .NET, and Azure</b>. Experienced in owning features end-to-end from business-level
      requirements through development and deployment, working closely with product teams to deliver practical solutions
      to business problems. Proven ability to collaborate with cross-functional teams, mentor junior developers, and
      deliver software in fast-paced product environments.
    </p>
  </CVSection>

  <CVSection title="Technical Skills">
    <div class="cv-skills">
      {
        skills.map((s, i) => (
          <>
            {i > 0 && <hr class="divider" />}
            <div class="cv-skill-group">
              <h3 class="cv-skill-heading">{s.group}</h3>
              <ul class="cv-skill-items">
                {s.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </>
        ))
      }
    </div>
  </CVSection>

  <CVSection title="Professional Experience" open={false}>
    <div class="stack">
      <div class="cv-role">
        <div class="cv-role-header">
          <strong>Software Developer</strong>
          <span class="cv-role-date">Jan 2025 – Present</span>
        </div>
        <p class="cv-role-company">
          <a href="https://www.kana.earth" target="_blank" rel="noopener noreferrer">Kana Earth</a>, London
        </p>
        <ul class="cv-list">
          <li>
            Owned end-to-end feature delivery, translating business requirements into technical solutions across
            frontend, backend, database, and deployment workflows.
          </li>
          <li>
            Collaborated with product managers and the wider product team to refine requirements, produce technical
            specifications, and estimate implementation effort for new features.
          </li>
          <li>
            Implemented architectural improvements and refactoring across frontend and backend applications to improve
            scalability and reliability.
          </li>
          <li>
            Designed and implemented reusable frontend and backend patterns to improve consistency and reduce duplicated
            implementation across applications.
          </li>
          <li>
            Contributed to event-driven backend workflows using <strong>CAP</strong> event bus patterns to support asynchronous
            processing and service decoupling.
          </li>
          <li>
            Supported deployment and infrastructure management through <strong>CI/CD</strong> pipelines,
            <strong>Azure</strong> troubleshooting, and <strong>Terraform</strong>-based workflows.
          </li>
          <li>
            Troubleshot and resolved production issues under tight time constraints while maintaining application
            stability and reliability.
          </li>
          <li>
            Mentored junior developers through pair programming, code reviews, and guidance on <strong>React</strong>,
            <strong>TypeScript</strong>, and frontend development best practices.
          </li>
          <li>
            Adopted <strong>AI</strong>-assisted engineering workflows using <strong>Codex</strong> and
            <strong>Claude Code</strong>, supported by repository-level <strong>AGENTS.md</strong> / CLAUDE.md guidance and
            <strong>Skills</strong>, to accelerate delivery while maintaining consistency across the codebase.
          </li>
        </ul>
      </div>
      <hr class="divider" />
      <div class="cv-role">
        <div class="cv-role-header">
          <strong>Junior Software Developer</strong>
          <span class="cv-role-date">Jul 2022 – Jan 2025</span>
        </div>
        <p class="cv-role-company">
          <a href="https://www.kana.earth" target="_blank" rel="noopener noreferrer">Kana Earth</a>, London
        </p>
        <ul class="cv-list">
          <li>
            Worked as part of the product team to develop authenticated web portals and public-facing applications with <strong
              >React (TypeScript)</strong
            > and <strong>ASP.NET Core (C#)</strong>.
          </li>
          <li>
            Implemented a modular component system using <strong>React components</strong> and <strong>hooks</strong>,
            supported by <strong>Storybook</strong> documentation and automated <strong>Jest</strong> testing to maintain
            component reliability and UI consistency.
          </li>
          <li>
            Designed and developed <strong>REST</strong> and <strong>GraphQL APIs</strong> implementing
            <strong>batching</strong>, <strong>caching</strong>, and <strong>CQRS</strong> to support efficient and scalable
            application data flows.
          </li>
          <li>
            Led the development of a configurable website built using <strong>Umbraco CMS</strong> in one month, providing
            an in-house alternative to a <strong>~£40,000</strong> agency quote.
          </li>
          <li>
            Wrote and maintained versioned <strong>SQL</strong> migration scripts for schema updates and data transformations.
          </li>
          <li>
            Participated in code reviews within a <strong>Git</strong>-based development workflow, ensuring code
            quality, maintainability, and consistency with existing patterns.
          </li>
        </ul>
      </div>
    </div>
  </CVSection>

  <CVSection title="Education / Qualifications">
    <div class="stack">
      <div class="cv-role">
        <div class="cv-role-header">
          <strong>B.Sc. (Hons) Computer Science – First Class</strong>
          <span class="cv-role-date">Sep 2020 – Jul 2023</span>
        </div>
        <p class="cv-role-company">
          <a href="https://sheffield.ac.uk/" target="_blank" rel="noopener noreferrer">The University of Sheffield</a>
        </p>
      </div>
      <hr class="divider" />
      <div class="cv-role">
        <div class="cv-role-header">
          <strong>A-Levels: Computer Science (A), Mathematics (A), Physics (A)</strong>
          <span class="cv-role-date">Sep 2018 – Jul 2020</span>
        </div>
        <p class="cv-role-company">
          <a href="https://www.ccsw.ac.uk/" target="_blank" rel="noopener noreferrer">South Cheshire College</a>, Crewe
        </p>
      </div>
      <hr class="divider" />
      <div class="cv-role">
        <div class="cv-role-header">
          <strong>GCSEs: 10 (A*–C)</strong>
          <span class="cv-role-date">Sep 2013 – Jul 2018</span>
        </div>
        <p class="cv-role-company">
          <a href="https://sandbachschool.org/" target="_blank" rel="noopener noreferrer">Sandbach Boys School</a>, Sandbach
        </p>
      </div>
    </div>
  </CVSection>
</DefaultTemplate>

<style>
  /* ── Sticky header — pins to the top of the viewport while scrolling ── */
  .cv-header-wrap {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    /* Top gutter lives here (not on body/main) so the header sits the same
       distance from the top whether at rest or pinned — it never moves */
    padding-top: var(--space-md);
    padding-bottom: var(--space-md);
  }

  @media (min-width: 720px) {
    .cv-header-wrap {
      padding-top: var(--space-lg);
      padding-bottom: var(--space-lg);
    }
  }

  /* Spacing lives on the wrapper so scrolled content stays hidden behind it */
  .cv-header-wrap :global(.cv-header) {
    margin-bottom: 0;
  }

  /* Top rule above the first section, matching the between-section dividers */
  :global(.cv-section:first-of-type) {
    border-top: 1px solid var(--color-border);
  }

  /* ── Skills: grouped 3-column table ───────────────────────────────── */
  .cv-skills {
    display: grid;
    gap: var(--space-sm);
  }

  .cv-skill-heading {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }

  .cv-skill-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2xs) var(--space-md);
  }

  /* ── Shared hover-indent: left accent + nudge on hover ────────────── */
  .cv-role,
  .cv-skill-group,
  .cv-profile {
    padding-left: var(--space-sm);
    border-left: 2px solid transparent;
    transition:
      border-color 200ms ease,
      padding-left 200ms ease;
  }

  .cv-role:hover,
  .cv-skill-group:hover,
  .cv-profile:hover {
    border-left-color: var(--color-border-strong);
    padding-left: var(--space-md);
  }

  /* ── Role entries (experience + education) ────────────────────────── */
  .cv-role {
    display: grid;
    gap: var(--space-2xs);
  }

  .cv-role-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .cv-role-date {
    font-size: 0.85rem;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .cv-role-company {
    color: var(--color-muted);
  }

  .cv-list {
    margin: var(--space-2xs) 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: var(--space-2xs);
  }

  /* Fewer columns as the viewport narrows */
  @media (max-width: 640px) {
    .cv-skill-items {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 400px) {
    .cv-skill-items {
      grid-template-columns: 1fr;
    }
  }

  /* ── Scroll reveal — sections fade + rise in as they enter the viewport ─
       Hiding is only applied once JS adds `.cv-reveal-ready`, so content
       stays visible without JS or when reduced motion is preferred. */
  @media (prefers-reduced-motion: no-preference) {
    :global(main.cv-reveal-ready .cv-section) {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 600ms ease,
        transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    :global(main.cv-reveal-ready .cv-section.is-visible) {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const main = document.querySelector("main");
  const sections = document.querySelectorAll<HTMLElement>("main .cv-section");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (main && sections.length && !prefersReducedMotion) {
    main.classList.add("cv-reveal-ready");

    const revealObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -10% 0px" },
    );

    sections.forEach((section) => revealObserver.observe(section));
  }
</script>
